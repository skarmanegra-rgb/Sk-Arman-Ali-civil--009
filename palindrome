
// Online C compiler to run C program online
#include <stdio.h>
void main() {
    int num, arr[10], i = 0, j, flag = 1;
printf("Enter a number: ");
    scanf("%d", &num);
    while (num != 0) {
        arr[i] = num % 10;
        num = num / 10;
        i++;
    }
    for (j = 0; j < i / 2; j++) {
        if (arr[j] != arr[i - j - 1]) {
            flag = 0;
            break;
        }
    }
    if (flag == 1)
        printf("Palindrome number");
    else
        printf("Not a palindrome number");

}
